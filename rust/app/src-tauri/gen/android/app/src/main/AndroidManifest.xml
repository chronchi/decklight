<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET is required even for the 127.0.0.1 loopback bind (EPERM without it, API 36; S3). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Card-art sync asks the system whether the active network is metered (normal permission, no prompt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Downloads keep going with the app closed (DownloadJob): a user-initiated data transfer job and its
         notification (the permission prompt shows the first time the user starts a download). -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.decklight_app"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- On-device Gemma runs on the GPU through LiteRT-LM's OpenCL accelerator: apps must declare the vendor's
             libOpenCL.so to load it (Android 12+). Not required: phones without it keep the cloud providers. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".DownloadJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
    </application>
</manifest>
